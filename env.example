# Persistent storage for Vercel (Hobby free tier is enough for demos)
#
# 1) In Vercel Dashboard → your project → Storage:
#    - Create "Postgres" (Neon) → connect to this project
#    - Create "Blob" → connect to this project
# 2) Redeploy (or run: vercel env pull)
# 3) Locally, copy these into .env.local after pulling:
#
# POSTGRES_URL=
# BLOB_READ_WRITE_TOKEN=
#
# Without these, the app still runs using local ./data (or /tmp on Vercel),
# but data can reset on serverless cold starts.

POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=
